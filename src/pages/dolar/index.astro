---
import Base from '../../layouts/Base.astro';
import MiniDollar from '../../components/MiniDollar.astro';
import LineChart from '../../components/LineChart.astro';
import AdSlot from '../../components/AdSlot.astro';
import Price from '../../components/Price.astro';
import Delta from '../../components/Delta.astro';
import Updated from '../../components/Updated.astro';
import { getSiteData } from '../../lib/data';
import { DOLLARS } from '../../lib/dollars';
import { brecha } from '../../lib/derived';
import { pct } from '../../lib/format';

const data = await getSiteData();
const d = data.dollars;
---
<Base title="Cotizaciones del dólar hoy: todos los tipos de cambio" description="Todos los tipos de dólar en Argentina en una tabla: blue, oficial, MEP, CCL, cripto, tarjeta y mayorista. Precio de compra y venta, variación y brecha en vivo." crumbs={[{ label: 'Dólar', href: '/dolar' }]}>
  <section class="page-head">
    <h1>Cotizaciones del dólar hoy</h1>
    <p class="lead">Todos los tipos de cambio de Argentina en un solo lugar. Tocá cualquiera para ver su historial.</p>
    <div class="status-line">
      <span class="pill" data-market-status data-state="closed"><span class="dot"></span><span class="lbl">Mercado</span></span>
      <span>Se actualiza solo cada minuto</span>
    </div>
  </section>

  <section class="card">
    <div class="tbl-wrap">
      <table class="tbl">
        <caption class="visually-hidden">Cotización de todos los tipos de dólar</caption>
        <thead>
          <tr><th scope="col">Dólar</th><th scope="col">Compra</th><th scope="col">Venta</th><th scope="col" class="opt">Variación</th><th scope="col" class="opt">Brecha</th><th scope="col" class="opt">Actualizado</th></tr>
        </thead>
        <tbody>
          {DOLLARS.map((m) => {
            const x = d[m.slug];
            return (
              <tr>
                <th scope="row"><a class="sym" href={`/dolar/${m.slug}`}>{x.nombre}</a><small class="muted" style="display:block;font-size:.76rem">{m.resumen}</small></th>
                <td>{x.compra != null ? <Price value={x.compra} live={`d:${m.slug}:compra`} /> : '—'}</td>
                <td><b><Price value={x.venta} live={`d:${m.slug}:venta`} /></b></td>
                <td class="opt"><Delta value={x.varPct} plain live={`d:${m.slug}:var`} /></td>
                <td class="opt">{m.slug === 'oficial' ? '—' : <span data-live={`brecha:${m.slug}`}>{pct(brecha(d, m.slug), 1, false)}</span>}</td>
                <td class="opt"><Updated iso={x.fecha} live={`d:${m.slug}:time`} /></td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
    <p class="tbl-foot">Variación contra el cierre del día hábil anterior. Brecha contra el dólar oficial.</p>
  </section>

  <section class="section">
    <LineChart
      title="Comparación histórica"
      label="Evolución del precio de venta de los dólares blue, oficial, MEP y CCL"
      series={[
        { key: 'blue', label: 'Blue', slot: 1, points: d.blue.history },
        { key: 'oficial', label: 'Oficial', slot: 2, points: d.oficial.history },
        { key: 'mep', label: 'MEP', slot: 3, points: d.mep.history },
        { key: 'ccl', label: 'CCL', slot: 4, points: d.ccl.history },
      ]}
      format="ars"
      range="6m"
      area={false}
      stats={false}
    />
  </section>

  <AdSlot slot="inline" />

  <section class="section">
    <div class="grid g-4">
      {DOLLARS.map((m) => <MiniDollar d={d[m.slug]} brecha={['blue', 'mep', 'ccl', 'cripto'].includes(m.slug) ? brecha(d, m.slug) : null} />)}
    </div>
  </section>

</Base>
