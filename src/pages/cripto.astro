---
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';
import Faq from '../components/Faq.astro';
import Price from '../components/Price.astro';
import Delta from '../components/Delta.astro';
import { getSiteData } from '../lib/data';
import { compact, num } from '../lib/format';

const data = await getSiteData();
const rate = data.dollars.cripto.venta;
const faq = [
  { q: '¿De dónde salen los precios de las criptomonedas?', a: '<p>De CoinGecko, que promedia precios de cientos de exchanges en todo el mundo. El precio en pesos es una referencia: multiplicamos el precio en dólares por el <a href="/dolar/cripto">dólar cripto</a>.</p>' },
  { q: '¿Qué es una stablecoin?', a: '<p>Una criptomoneda diseñada para mantener un valor estable, generalmente un dólar. USDT y USDC son las más usadas en Argentina para ahorrar o mover dinero.</p>' },
  { q: '¿Es seguro invertir en cripto?', a: '<p>Las criptomonedas son activos muy volátiles: pueden subir o bajar mucho en poco tiempo. Informate bien y no inviertas dinero que puedas necesitar. Esto no es una recomendación de inversión.</p>' },
];
---
<Base title="Criptomonedas hoy: precio de Bitcoin, Ethereum y USDT en dólares y pesos" description="Precio de Bitcoin, Ethereum, USDT, Solana y las principales criptomonedas hoy, en dólares y en pesos argentinos, actualizado en vivo." crumbs={[{ label: 'Cripto', href: '/cripto' }]}>
  <section class="page-head">
    <h1>Criptomonedas hoy</h1>
    <p class="lead">Principales criptomonedas por capitalización, en dólares y en pesos al dólar cripto (${num(rate, 2)}). Se actualiza sola cada dos minutos.</p>
  </section>

  <section class="card">
    <div class="tbl-wrap">
      <table class="tbl">
        <caption class="visually-hidden">Precio de las principales criptomonedas</caption>
        <thead>
          <tr><th scope="col">Moneda</th><th scope="col">Precio US$</th><th scope="col">24 h</th><th scope="col" class="opt">7 días</th><th scope="col">Precio $</th><th scope="col" class="opt">Capitalización</th><th scope="col" class="opt">Volumen 24 h</th></tr>
        </thead>
        <tbody>
          {data.crypto.map((c) => (
            <tr>
              <th scope="row"><span class="sym">{c.symbol}<small>{c.name}</small></span></th>
              <td><Price value={c.price} cur="US$" live={`c:${c.id}:price`} /></td>
              <td><Delta value={c.pct24h} plain live={`c:${c.id}:pct24h`} /></td>
              <td class="opt"><Delta value={c.pct7d} plain live={`c:${c.id}:pct7d`} /></td>
              <td><span class="num" data-live={`c:${c.id}:ars`} data-rate={rate} data-fmt="plain" data-cur="$">${num(c.price * rate, c.price * rate >= 100 ? 0 : 2)}</span></td>
              <td class="opt">US${compact(c.mcap)}</td>
              <td class="opt">US${compact(c.volume)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="tbl-foot">Fuente: CoinGecko. Precio en pesos calculado con el dólar cripto de venta.</p>
  </section>

  <AdSlot slot="inline" />

  <Faq items={faq} />
</Base>
