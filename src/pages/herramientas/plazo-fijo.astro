---
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/AdSlot.astro';
import { getSiteData } from '../../lib/data';
import { pct, price } from '../../lib/format';

const data = await getSiteData();
const banks = data.plazoFijo;
const best = banks[0];
const mep = data.dollars.mep.venta;
const inf = data.inflacion.ultimo;
const json = JSON.stringify({ mep, infl: inf[1], inflMes: inf[0] }).replace(/</g, '\\u003c');
---
<Base title="Simulador de plazo fijo: rendimiento, dólar MEP e inflación" description="Simulá el rendimiento de un plazo fijo y comparalo con el dólar MEP y la inflación. Tasas de plazo fijo por banco." crumbs={[{ label: 'Plazo fijo', href: '/herramientas/plazo-fijo' }]}>
  <section class="page-head">
    <h1>Plazo fijo vs. dólar e inflación</h1>
    <p class="lead">Rendimiento de un plazo fijo comparado con el dólar MEP y la última inflación.</p>
  </section>

  <div class="grid g-main" data-pf data-live-need="d:">
    <section class="card" aria-labelledby="pf-in">
      <h2 id="pf-in" class="mt-0" style="font-size:1rem;margin-bottom:14px">Tu plazo fijo</h2>
      <div class="form-row">
        <div class="field">
          <label for="pf-monto">Monto</label>
          <div class="input-group"><span class="affix">$</span><input id="pf-monto" class="input" inputmode="decimal" value="1.000.000" autocomplete="off" /></div>
        </div>
        <div class="field">
          <label for="pf-dias">Plazo (días)</label>
          <input id="pf-dias" class="input" inputmode="numeric" value="30" autocomplete="off" />
        </div>
        <div class="field">
          <label for="pf-tna">TNA %</label>
          <input id="pf-tna" class="input" inputmode="decimal" value="20,0" autocomplete="off" />
        </div>
      </div>

      <div class="result-list mt-3" aria-live="polite">
        <div class="result-row"><span>Intereses ganados</span><b data-o="int">—</b></div>
        <div class="result-row"><span>Total al vencimiento</span><b data-o="total">—</b></div>
        <div class="result-row"><span>Tasa efectiva del período</span><b data-o="tep">—</b></div>
        <div class="result-row"><span>Tasa efectiva anual (renovando)</span><b data-o="tea">—</b></div>
      </div>
    </section>

    <aside class="grid" style="align-content:start">
      <article class="card">
        <h2 class="card-title">Contra el dólar MEP</h2>
        <p class="mt-1" style="margin-bottom:6px">Dólar de equilibrio al vencimiento:</p>
        <div class="mid" data-o="eq">—</div>
      </article>
      <article class="card">
        <h2 class="card-title">Contra la inflación</h2>
        <p class="mt-1" style="margin-bottom:6px">Tasa real mensual estimada:</p>
        <div class="mid" data-o="real">—</div>
      </article>
    </aside>
  </div>
  <script type="application/json" id="pf-data" set:html={json} />

  <AdSlot slot="inline" />

  <section class="section card" aria-labelledby="tasas">
    <div class="section-head"><div><h2 id="tasas">Tasas de plazo fijo por banco</h2><p>TNA para plazos fijos tradicionales a 30 días.</p></div></div>
    <div class="tbl-wrap">
      <table class="tbl">
        <caption class="visually-hidden">Tasas de plazo fijo por banco</caption>
        <thead><tr><th scope="col">Banco</th><th scope="col">TNA clientes</th><th scope="col">TNA no clientes</th><th scope="col" class="opt">Ganancia mensual c/ $1.000.000</th></tr></thead>
        <tbody>
          {banks.map((b) => (
            <tr>
              <th scope="row">{b.enlace ? <a href={b.enlace} rel="nofollow noopener" target="_blank">{b.entidad}</a> : b.entidad}</th>
              <td><b>{pct(b.tna * 100, 2, false)}</b></td>
              <td>{b.tnaNoClientes ? pct(b.tnaNoClientes * 100, 2, false) : '—'}</td>
              <td class="opt">${price(1_000_000 * b.tna * 30 / 365)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="tbl-foot">Fuente: BCRA vía ArgentinaDatos.</p>
  </section>

</Base>

<script>
  import { pct, price, monthYear } from '../../lib/format';
  const root = document.querySelector<HTMLElement>('[data-pf]')!;
  const cfg: { mep: number; infl: number; inflMes: string } = JSON.parse(document.getElementById('pf-data')!.textContent!);
  const $ = (id: string) => root.querySelector<HTMLInputElement>(id)!;
  const monto = $('#pf-monto');
  const dias = $('#pf-dias');
  const tna = $('#pf-tna');
  const out = (k: string, v: string) => {
    const el = root.querySelector(`[data-o="${k}"]`);
    if (el) el.textContent = v;
  };
  const parse = (s: string) => Number(s.replace(/\./g, '').replace(',', '.')) || 0;

  function calc() {
    const m = parse(monto.value);
    const d = Math.max(1, Math.round(parse(dias.value)));
    const r = parse(tna.value) / 100;
    const tep = (r * d) / 365;
    const interes = m * tep;
    const tea = Math.pow(1 + tep, 365 / d) - 1;
    out('int', `$${price(interes)}`);
    out('total', `$${price(m + interes)}`);
    out('tep', pct(tep * 100, 2, false));
    out('tea', pct(tea * 100, 2, false));
    const eq = cfg.mep * (1 + tep);
    out('eq', `$${price(eq)}`);
    const tem = Math.pow(1 + tep, 30 / d) - 1;
    const real = ((1 + tem) / (1 + cfg.infl / 100) - 1) * 100;
    out('real', pct(real, 2));
  }
  [monto, dias, tna].forEach((i) => i.addEventListener('input', calc));
  document.addEventListener('dolarahora:dollars', (e) => {
    const m = (e as CustomEvent).detail.mep;
    if (m) {
      cfg.mep = m.venta;
      calc();
    }
  });
  calc();
</script>
