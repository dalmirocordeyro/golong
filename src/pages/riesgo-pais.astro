---
import Base from '../layouts/Base.astro';
import LineChart from '../components/LineChart.astro';
import AdSlot from '../components/AdSlot.astro';
import StatTile from '../components/StatTile.astro';
import Delta from '../components/Delta.astro';
import RiesgoCompras from '../components/RiesgoCompras.astro';
import { getSiteData } from '../lib/data';
import { dmy, num } from '../lib/format';
import { rangeStats, sliceRange } from '../lib/series';

const data = await getSiteData();
const r = data.riesgo;
const y1 = rangeStats(sliceRange(r.history, 366));
const m1 = rangeStats(sliceRange(r.history, 31));
const all = rangeStats(r.history);
---
<Base title="Riesgo país hoy: valor del EMBI de Argentina y evolución" description="Riesgo país de Argentina hoy: valor del índice EMBI de JP Morgan en puntos básicos, variación diaria y gráfico histórico desde 1999." crumbs={[{ label: 'Riesgo país', href: '/riesgo-pais' }]}>
  <section class="page-head">
    <h1>Riesgo país hoy</h1>
    <p class="lead">Índice EMBI de JP Morgan para Argentina, en puntos básicos. Dato de cierre del {dmy(r.fecha)}.</p>
  </section>

  <div class="grid g-4">
    <StatTile label="Riesgo país" note={`Cierre ${dmy(r.fecha)}`}>
      <Delta slot="delta" value={r.varPts} mode="pts" />
      {num(r.valor, 0)} <small>pts</small>
    </StatTile>
    {m1 && <StatTile label="Último mes" note={`Hace un mes: ${num(m1.first, 0)} pts`}>{m1.changeAbs >= 0 ? '+' : ''}{num(m1.changeAbs, 0)} <small>pts</small></StatTile>}
    {y1 && <StatTile label="Mínimo del último año" note={dmy(y1.min[0])}>{num(y1.min[1], 0)} <small>pts</small></StatTile>}
    {y1 && <StatTile label="Máximo del último año" note={dmy(y1.max[0])}>{num(y1.max[1], 0)} <small>pts</small></StatTile>}
  </div>

  <section class="section">
    <LineChart
      title="Evolución del riesgo país"
      subtitle="Puntos básicos. Diario en el último año, semanal antes."
      label="Gráfico histórico del riesgo país de Argentina"
      series={[{ key: 'riesgo', label: 'Riesgo país', slot: 1, points: r.history }]}
      format="pts"
      range="1a"
      ranges={['1m', '3m', '6m', '1a', '5a', 'max']}
    />
  </section>

  {data.bcra && (
    <section class="section">
      <RiesgoCompras riesgo={r.history} bcra={data.bcra} />
    </section>
  )}

  <AdSlot slot="inline" />


</Base>
