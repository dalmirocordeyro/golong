---
import Base from '../../layouts/Base.astro';
import DataTable, { type Column } from '../../components/DataTable.astro';
import AdSlot from '../../components/AdSlot.astro';
import Faq from '../../components/Faq.astro';
import Updated from '../../components/Updated.astro';
import { getSiteData } from '../../lib/data';
import { compact, price } from '../../lib/format';
import { deltaHtml, escapeHtml } from '../../lib/html';
import { ADR_NAMES } from '../../content/names';
import type { Quote } from '../../lib/types';

const data = await getSiteData();
const cols: Column<Quote>[] = [
  { key: 'sym', label: 'ADR', v: (r) => r.symbol, html: (r) => `<span class="sym">${escapeHtml(r.symbol)}<small>${escapeHtml(ADR_NAMES[r.symbol] ?? '')}</small></span>` },
  { key: 'price', label: 'Precio', v: (r) => r.price, html: (r) => `US$${price(r.price)}` },
  { key: 'pct', label: 'Var. %', v: (r) => r.pct, html: (r) => deltaHtml(r.pct, { plain: true }) },
  { key: 'monto', label: 'Monto', v: (r) => r.monto, html: (r) => `US$${compact(r.monto)}`, opt: true },
];
const faq = [
  { q: '¿Qué es un ADR?', a: '<p>Un American Depositary Receipt: un certificado que permite que las acciones de una empresa extranjera se negocien en la bolsa de Nueva York. Muchas empresas argentinas, como YPF o Grupo Galicia, tienen ADRs.</p>' },
  { q: '¿Por qué miran los ADRs cuando la bolsa porteña está cerrada?', a: '<p>Porque Wall Street opera en otro horario y en días que en Argentina pueden ser feriado. Los ADRs anticipan cómo puede abrir el mercado local.</p>' },
];
---
<Base title="ADRs argentinos hoy: YPF, Galicia y más en Wall Street" description="Cotización de los ADRs argentinos hoy en Nueva York: YPF, Grupo Galicia, Pampa, Mercado Libre, Globant, Vista y más, con variación diaria." crumbs={[{ label: 'Mercados', href: '/mercado/acciones' }, { label: 'ADRs', href: '/mercado/adrs' }]}>
  <section class="page-head">
    <h1>ADRs argentinos hoy</h1>
    <p class="lead">Empresas argentinas (y latinoamericanas con fuerte presencia local) que cotizan en Wall Street. Precios en dólares, con demora.</p>
    <div class="status-line"><Updated iso={data.generatedAt} prefix="Datos de " /></div>
  </section>

  <section class="card">
    <DataTable rows={[...data.adrs].sort((a, b) => b.monto - a.monto)} columns={cols} caption="ADRs argentinos" sortKey="monto" note="Monto operado en dólares." />
  </section>

  <AdSlot slot="inline" />

  <Faq items={faq} />
</Base>
