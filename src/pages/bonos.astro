---
import Base from '../layouts/Base.astro';
import DataTable, { type Column } from '../components/DataTable.astro';
import AdSlot from '../components/AdSlot.astro';
import Faq from '../components/Faq.astro';
import StatTile from '../components/StatTile.astro';
import Delta from '../components/Delta.astro';
import Updated from '../components/Updated.astro';
import { getSiteData } from '../lib/data';
import { compact, num, price } from '../lib/format';
import { deltaHtml, escapeHtml } from '../lib/html';
import { BOND_NAMES } from '../lib/sources';
import type { Bond, Quote } from '../lib/types';

const data = await getSiteData();
const mepVals = data.bonds.map((b) => b.mep).filter((x): x is number => x != null);
const al30 = data.bonds.find((b) => b.symbol === 'AL30');
const gd30 = data.bonds.find((b) => b.symbol === 'GD30');

const colsUsd: Column<Bond>[] = [
  { key: 'sym', label: 'Bono', v: (r) => r.symbol, html: (r) => `<span class="sym">${escapeHtml(r.symbol)}<small>${escapeHtml(r.nombre)} · Ley ${r.ley === 'NY' ? 'NY' : 'local'}</small></span>` },
  { key: 'usd', label: 'Precio US$', v: (r) => r.priceUsd, html: (r) => (r.priceUsd ? `US$${price(r.priceUsd)}` : '—') },
  { key: 'pctusd', label: 'Var. US$', v: (r) => r.pctUsd, html: (r) => deltaHtml(r.pctUsd, { plain: true }) },
  { key: 'ars', label: 'Precio $', v: (r) => r.price, html: (r) => `$${price(r.price)}` },
  { key: 'pct', label: 'Var. $', v: (r) => r.pct, html: (r) => deltaHtml(r.pct, { plain: true }), opt: true },
  { key: 'mep', label: 'MEP implícito', v: (r) => r.mep, html: (r) => (r.mep ? `$${price(r.mep)}` : '—') },
  { key: 'monto', label: 'Monto $', v: (r) => r.monto, html: (r) => `$${compact(r.monto)}`, opt: true },
];
const colsPesos: Column<Quote>[] = [
  { key: 'sym', label: 'Título', v: (r) => r.symbol, html: (r) => `<span class="sym">${escapeHtml(r.symbol)}<small>${escapeHtml(BOND_NAMES[r.symbol] ?? '')}</small></span>` },
  { key: 'price', label: 'Precio', v: (r) => r.price, html: (r) => `$${price(r.price)}` },
  { key: 'pct', label: 'Var. %', v: (r) => r.pct, html: (r) => deltaHtml(r.pct, { plain: true }) },
  { key: 'monto', label: 'Monto', v: (r) => r.monto, html: (r) => `$${compact(r.monto)}`, opt: true },
];
const faq = [
  { q: '¿Qué diferencia hay entre los bonos AL y GD?', a: '<p>Los <strong>AL</strong> (Bonares) se rigen por ley argentina y los <strong>GD</strong> (Globales) por ley de Nueva York. Tienen flujos de pago muy parecidos, pero los Globales suelen cotizar algo más caros porque los inversores valoran la jurisdicción extranjera.</p>' },
  { q: '¿Por qué el precio es "cada 100 nominales"?', a: '<p>Los bonos cotizan por cada 100 unidades de valor nominal. Si el AL30D cotiza US$55, comprar 100 nominales cuesta aproximadamente US$55 más comisiones.</p>' },
  { q: '¿Qué es el MEP implícito de un bono?', a: '<p>Es el tipo de cambio que surge de dividir el precio del bono en pesos por su precio en dólares. Muestra a qué dólar estarías comprando si hacés la operación MEP con ese bono. <a href="/dolar/mep">Más sobre el dólar MEP</a>.</p>' },
];
---
<Base title="Bonos argentinos hoy: AL30, GD30 y soberanos en dólares" description="Cotización de los bonos soberanos argentinos hoy: AL30, GD30, AL35, GD35, AE38 y más. Precio en dólares y en pesos, variación y MEP implícito." crumbs={[{ label: 'Bonos', href: '/bonos' }]}>
  <section class="page-head">
    <h1>Bonos argentinos hoy</h1>
    <p class="lead">Bonos soberanos en dólares (Bonares y Globales) y títulos en pesos. Precios cada 100 nominales, con demora.</p>
    <div class="status-line">
      <span class="pill" data-market-status data-state="closed"><span class="dot"></span><span class="lbl">Mercado</span></span>
      <Updated iso={data.generatedAt} prefix="Datos de " />
    </div>
  </section>

  <div class="grid g-4">
    {al30 && <StatTile label="AL30D" note="Bonar 2030 · ley local"><Delta slot="delta" value={al30.pctUsd} />US${price(al30.priceUsd)}</StatTile>}
    {gd30 && <StatTile label="GD30D" note="Global 2030 · ley NY"><Delta slot="delta" value={gd30.pctUsd} />US${price(gd30.priceUsd)}</StatTile>}
    <StatTile label="Riesgo país" href="/riesgo-pais" note="Puntos básicos"><Delta slot="delta" value={data.riesgo.varPts} mode="pts" />{num(data.riesgo.valor, 0)}</StatTile>
    {mepVals.length > 0 && <StatTile label="MEP implícito (rango)" href="/dolar/mep" note="Según el bono que uses"><span style="font-size:.82em">${num(Math.min(...mepVals), 0)}–{num(Math.max(...mepVals), 0)}</span></StatTile>}
  </div>

  <section class="section card" aria-labelledby="usd-title">
    <div class="section-head"><div><h2 id="usd-title">Soberanos en dólares</h2><p>Tocá una columna para ordenar.</p></div></div>
    <DataTable rows={data.bonds} columns={colsUsd} caption="Bonos soberanos en dólares" note="Precio en dólares: especie D (MEP). MEP implícito = precio en pesos ÷ precio en dólares." />
  </section>

  <AdSlot slot="inline" />

  {data.bondsPesos.length > 0 && (
    <section class="section card" aria-labelledby="ars-title">
      <div class="section-head"><div><h2 id="ars-title">Títulos en pesos</h2><p>Bonos ajustados por CER, Boncaps y otros.</p></div></div>
      <DataTable rows={data.bondsPesos} columns={colsPesos} caption="Títulos públicos en pesos" sortKey="monto" />
    </section>
  )}

  <Faq items={faq} />
</Base>
