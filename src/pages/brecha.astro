---
import Base from '../layouts/Base.astro';
import LineChart from '../components/LineChart.astro';
import AdSlot from '../components/AdSlot.astro';
import StatTile from '../components/StatTile.astro';
import { getSiteData } from '../lib/data';
import { brecha, brechaHistory } from '../lib/derived';
import { pct } from '../lib/format';
import { rangeStats, sliceRange } from '../lib/series';

const data = await getSiteData();
const d = data.dollars;
const hist = {
  blue: brechaHistory(d, 'blue'),
  mep: brechaHistory(d, 'mep'),
  ccl: brechaHistory(d, 'ccl'),
};
const yr = rangeStats(sliceRange(hist.blue, 366));
---
<Base title="Brecha cambiaria hoy: blue, MEP y CCL vs. oficial" description="Brecha cambiaria hoy entre el dólar oficial y el blue, MEP, CCL y cripto. Valor en vivo y gráfico histórico." crumbs={[{ label: 'Brecha cambiaria', href: '/brecha' }]}>
  <section class="page-head">
    <h1>Brecha cambiaria hoy</h1>
    <p class="lead">Cuánto más caro está cada dólar alternativo respecto del dólar oficial.</p>
  </section>

  <div class="grid g-4">
    {(['blue', 'mep', 'ccl', 'cripto'] as const).map((s) => (
      <StatTile label={`${d[s].nombre} vs. oficial`} href={`/dolar/${s}`} note={`${d[s].nombreCorto} $${d[s].venta.toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} · Oficial $${d.oficial.venta.toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`}>
        <span data-live={`brecha:${s}`}>{pct(brecha(d, s), 1, false)}</span>
      </StatTile>
    ))}
  </div>

  <section class="section">
    <LineChart
      title="Evolución de la brecha"
      subtitle="Diferencia porcentual contra el dólar oficial (venta)."
      label="Evolución de la brecha cambiaria del blue, MEP y CCL contra el oficial"
      series={[
        { key: 'blue', label: 'Blue', slot: 1, points: hist.blue },
        { key: 'mep', label: 'MEP', slot: 3, points: hist.mep },
        { key: 'ccl', label: 'CCL', slot: 4, points: hist.ccl },
      ]}
      format="pct"
      range="1a"
      area={false}
      refLine={0}
      statsLabels={{ chg: 'Cambio de la brecha blue' }}
    />
  </section>

  <AdSlot slot="inline" />


</Base>
