---
import Base from '../layouts/Base.astro';
import { SITE } from '../site.config';
---
<Base title="Contacto" description={`Cómo contactar a ${SITE.author.name}, creador de ${SITE.name}.`} crumbs={[{ label: 'Contacto', href: '/contacto' }]}>
  <section class="page-head">
    <h1>Contacto</h1>
    <p class="lead"></p>
  </section>
  <section class="card prose">
    {SITE.contactEmail ? (
      <p>Escribime a <a href={`mailto:${SITE.contactEmail}`}><strong>{SITE.contactEmail}</strong></a> y te respondo apenas pueda.</p>
    ) : (
      <p>dalmiro@gmail.com</p>
    )}
    {SITE.x && <p>También estoy en X como <a href={`https://x.com/${SITE.x}`} rel="noopener" target="_blank">@{SITE.x}</a>.</p>}
    
  </section>
</Base>
