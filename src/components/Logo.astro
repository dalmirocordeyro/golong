---
import { SITE } from '../site.config';
interface Props { size?: number; href?: string }
const { size = 26, href = '/' } = Astro.props;
---
<a class="logo" href={href} aria-label={`${SITE.name}, inicio`}>
  <svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
    <rect width="32" height="32" rx="9" fill="var(--text)" />
    <path d="M7 21.5l6-6 4 4 8-9" fill="none" stroke="var(--bg)" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M19.5 10.5H25v5.5" fill="none" stroke="var(--accent)" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  <span>{SITE.name}</span>
</a>
