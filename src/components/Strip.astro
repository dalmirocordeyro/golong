---
import type { SiteData } from '../lib/types';
import { num, pct, price } from '../lib/format';
import { brecha } from '../lib/derived';
import Delta from './Delta.astro';
interface Props { data: SiteData }
const { data } = Astro.props;
const d = data.dollars;
const btc = data.crypto.find((c) => c.id === 'bitcoin');
---
<div class="strip" aria-label="Indicadores principales">
  <div class="wrap strip-row">
    {(['blue', 'oficial', 'mep', 'ccl', 'cripto'] as const).map((s) => (
      <a href={`/dolar/${s}`}>
        {d[s].nombreCorto} <b data-live={`d:${s}:venta`} data-fmt="plain" data-cur="$">${price(d[s].venta)}</b>
        <Delta value={d[s].varPct} plain live={`d:${s}:var`} />
      </a>
    ))}
    <a href="/brecha">Brecha <b data-live="brecha:blue">{pct(brecha(d, 'blue'), 1, false)}</b></a>
    <a href="/riesgo-pais">Riesgo país <b>{num(data.riesgo.valor, 0)}</b> <Delta value={data.riesgo.varPts} mode="pts" plain /></a>
    <a href="/inflacion">Inflación <b>{pct(data.inflacion.ultimo[1], 1, false)}</b></a>
    {btc && (
      <a href="/cripto">BTC <b data-live="c:bitcoin:price" data-fmt="plain" data-cur="US$" data-dec="0">US${num(btc.price, 0)}</b> <Delta value={btc.pct24h} plain live="c:bitcoin:pct24h" /></a>
    )}
  </div>
</div>
