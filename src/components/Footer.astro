---
import { SITE } from '../site.config';
import Logo from './Logo.astro';
import Updated from './Updated.astro';
import SobreProyecto from './SobreProyecto.astro';
interface Props { generatedAt: string }
const { generatedAt } = Astro.props;
const year = new Date(generatedAt).getFullYear();
// Perfiles públicos del autor (GitHub, LinkedIn): enlazados en todas las páginas.
const perfiles = SITE.author.sameAs.map((url) => ({
  url,
  nombre: url.includes('github') ? 'GitHub' : url.includes('linkedin') ? 'LinkedIn' : url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, ''),
}));
// Frases de búsqueda frecuentes, cada una enlazada a su página.
const TAGS: [string, string][] = [
  ['Dólar hoy Argentina', '/dolar'], ['Dólar blue hoy', '/dolar/blue'], ['Dólar oficial', '/dolar/oficial'], ['Dólar MEP', '/dolar/mep'],
  ['Dólar CCL', '/dolar/ccl'], ['Dólar tarjeta', '/dolar/tarjeta'], ['Brecha cambiaria', '/brecha'], ['Riesgo país', '/riesgo-pais'],
  ['Mercados de Argentina', '/acciones'], ['Merval hoy', '/acciones'], ['Bonos argentinos', '/bonos'], ['CEDEARs', '/cedears'],
  ['ADRs argentinos', '/adrs'], ['Inflación Argentina', '/inflacion'], ['BTC', '/cripto'], ['Precio BTC', '/cripto'],
  ['Precio Bitcoin', '/cripto'], ['Precio Ethereum', '/cripto'], ['Plazo fijo vs dólar', '/herramientas/plazo-fijo'], ['Carry trade', '/herramientas/carry-trade'], ['Conversor de monedas', '/herramientas/conversor'],
];
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <Logo size={22} />
        <p class="footer-tags">
          {TAGS.map(([label, href], i) => <>{i > 0 && ' · '}<a href={href}>{label}</a></>)}
        </p>
        <Updated iso={generatedAt} prefix="Datos generados " />
      </div>
      <div>
        <h3>Dólar</h3>
        <ul>
          <li><a href="/dolar/blue">Dólar blue</a></li>
          <li><a href="/dolar/oficial">Dólar oficial</a></li>
          <li><a href="/dolar/mep">Dólar MEP</a></li>
          <li><a href="/dolar/ccl">Dólar CCL</a></li>
          <li><a href="/dolar/cripto">Dólar cripto</a></li>
          <li><a href="/dolar/tarjeta">Dólar tarjeta</a></li>
          <li><a href="/brecha">Brecha cambiaria</a></li>
        </ul>
      </div>
      <div>
        <h3>Mercados</h3>
        <ul>
          <li><a href="/acciones">Acciones del Merval</a></li>
          <li><a href="/bonos">Bonos soberanos</a></li>
          <li><a href="/cedears">CEDEARs</a></li>
          <li><a href="/adrs">ADRs argentinos</a></li>
          <li><a href="/cripto">Criptomonedas</a></li>
          <li><a href="/riesgo-pais">Riesgo país</a></li>
          <li><a href="/inflacion">Inflación</a></li>
        </ul>
      </div>
      <div>
        <h3>Herramientas</h3>
        <ul>
          <li><a href="/herramientas/conversor">Conversor de monedas</a></li>
          <li><a href="/herramientas/plazo-fijo">Plazo fijo vs dólar</a></li>
          <li><a href="/herramientas/carry-trade">Carry trade</a></li>
        </ul>
        <h3 class="mt-3">El sitio</h3>
        <ul>
          <li><a href="/sobre-mi">Sobre mí</a></li>
          <li><a href="/fuentes">Fuentes de datos</a></li>
        </ul>
      </div>
    </div>
    <section class="footer-about" aria-labelledby="sobre-sitio">
      <h3 id="sobre-sitio">Sobre {SITE.name}</h3>
      <SobreProyecto />
    </section>
    <div class="footer-bottom">
      <span>© {year} {SITE.name}</span>
      <span>
        Hecho por <a href="/sobre-mi" rel="author">{SITE.author.name}</a>
        {perfiles.map((p) => <> · <a href={p.url} rel="me noopener" target="_blank">{p.nombre}</a></>)}
      </span>
    </div>
  </div>
</footer>
